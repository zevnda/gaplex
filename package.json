{
  "name": "gaplex",
  "version": "0.1.0",
  "description": "Gapless internet radio streamer that pulls tracks from a YouTube Music playlist and feeds them to Icecast via Liquidsoap",
  "author": "zevnda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zevnda/gaplex.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && node scripts/copy-assets.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
